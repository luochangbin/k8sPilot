# LLM provider (API key is required unless the endpoint does not authenticate)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=2048

# Connector
CONNECTOR_BASE_URL=http://localhost:8080
CONNECTOR_TIMEOUT_SECONDS=15

# Agent runtime
AGENT_PORT=8000
# Investigation budgets: rounds = LLM decision responses, tool calls = tools
# actually executed (submit_result never counts).
MAX_AGENT_ROUNDS=12
MAX_TOOL_CALLS=12
# Global worker pool: extra requests stay queued until a worker frees up.
MAX_CONCURRENT_DIAGNOSES=4
# Terminal-only rounds granted once the investigation budget is exhausted
# (only submit_result is callable; recorded in the trace).
AGENT_FINALIZATION_ATTEMPTS=1

# Optional persistence and evaluation paths; absolute paths are recommended
TRACE_DIR=
DIAGNOSIS_DB=
KNOWLEDGE_DB=

# Model profiles (handoff §4). Leave LLM_PROFILES_FILE empty to keep the legacy
# LLM_* configuration as the single `default` profile.
# LLM_PROFILES_FILE=llm-profiles.yaml
# Explicit per-request model selection is off by default; benchmark/eval turns
# it on. Requests carrying `model_profile` are rejected with 403 while off.
ENABLE_MODEL_PROFILE_SELECTION=false
# Provider keys referenced by `api_key_env` in the profiles file (examples):
# COMMANDCODE_API_KEY=

# Phase 5 alert auto-diagnosis: max alert-triggered requests accepted per
# rolling minute (storm protection); 0 disables the limiter.
ALERT_RATE_LIMIT_PER_MINUTE=30
# An alert lifecycle claimed but not yet linked to a diagnosis is treated as
# orphaned after this many seconds, allowing a retry to take it over.
ALERT_CLAIM_STALE_SECONDS=300
